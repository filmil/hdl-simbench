load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Correctness first: each simulator must run each case to the cycle count
# RTLMeter expects, with the expected output, before any of its timings
# count. These tests are that check. Timed runs use the same script.

exports_files(["rtlmeter_case.sh"])

_EXAMPLE_ARGS = [
    "--top",
    "top",
    "--clock",
    "top.clk",
    "--cycles",
    "1000000",
    "--expect",
    # Quoted inside: Bazel splits test args on spaces, as a shell would.
    "'1000000 - Hello World!'",
]

_EXAMPLE_SRCS = [
    "$(rootpaths //third_party/rtlmeter:harness)",
    "$(rootpaths //third_party/rtlmeter:example_srcs)",
]

sh_test(
    name = "example_verilator_test",
    size = "medium",
    srcs = ["rtlmeter_case.sh"],
    args = [
        "--sim",
        "verilator",
        "--tool",
        "$(rootpath @verilator_prebuilt//:verilator)",
    ] + _EXAMPLE_ARGS + ["--"] + _EXAMPLE_SRCS,
    data = [
        "//third_party/rtlmeter:example_srcs",
        "//third_party/rtlmeter:harness",
        "@verilator_prebuilt//:includes",
        "@verilator_prebuilt//:verilator",
    ],
    # Compiles C++ with the host compiler.
    tags = ["requires-cc"],
)

sh_test(
    name = "example_iverilog_test",
    size = "medium",
    srcs = ["rtlmeter_case.sh"],
    args = [
        "--sim",
        "iverilog",
        "--tool",
        "$(rootpath @iverilog//:iverilog)",
        "--tool2",
        "$(rootpath @iverilog//:vvp)",
    ] + _EXAMPLE_ARGS + ["--"] + _EXAMPLE_SRCS,
    data = [
        "//third_party/rtlmeter:example_srcs",
        "//third_party/rtlmeter:harness",
        "@iverilog",
        "@iverilog//:vvp",
    ],
)
