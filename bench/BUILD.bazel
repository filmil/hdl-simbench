load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Correctness first: each simulator must run each case to the cycle count
# RTLMeter expects, before any of its timings count. The cases' tests are
# made by rtlmeter_design() (rtlmeter.bzl) in each design's package, from
# rtlmeter_case.sh; timed runs use the same script.

exports_files([
    "expect_unsupported.sh",
    "rtlmeter_case.sh",
])

# RTLMeter's harness names the main clock as $root.<clock>. Icarus Verilog
# does not support $root, so it gets this copy, made from the unchanged
# third-party file with only "$root." removed. The harness is instantiated
# inside the top module, so "<top>.<clock>" names the same signal there.
genrule(
    name = "harness_noroot",
    srcs = ["//third_party/rtlmeter:harness"],
    outs = ["noroot/__rtlmeter_utils.sv"],
    cmd = "sed -e 's/\\$$root\\.//g' $< > $@ && ! grep -q '\\$$root' $@",
    visibility = ["//visibility:public"],
)

# The check must fail when a case is wrong: RTLMeter's Example under Icarus,
# once with the wrong expected cycle count and once with an expected line
# the design never prints. Each must make rtlmeter_case.sh exit 1.
sh_test(
    name = "check_fails_test",
    size = "medium",
    srcs = ["expect_failure.sh"],
    args = [
        "$(rootpath :rtlmeter_case.sh)",
        "--sim",
        "iverilog",
        "--tool",
        "$(rootpath @iverilog//:iverilog)",
        "--tool2",
        "$(rootpath @iverilog//:vvp)",
        "--ivl-base",
        "$(rootpath @iverilog//:ivl_base)",
        "--top",
        "top",
        "--define",
        "__RTLMETER_MAIN_CLOCK=top.clk",
        "--include",
        "$(rootpath //third_party/rtlmeter:harness_include)",
        "--",
        "$(rootpath //third_party/rtlmeter/designs/Example:src/top.v)",
        "$(rootpath :harness_noroot)",
    ],
    data = [
        ":harness_noroot",
        ":rtlmeter_case.sh",
        "//third_party/rtlmeter:harness_include",
        "//third_party/rtlmeter/designs/Example:src/top.v",
        "@iverilog",
        "@iverilog//:ivl_base",
        "@iverilog//:vvp",
    ],
)

# The driver of the timed runs (see its header). Build it, then run
# bazel-bin/bench/timed_runs from the workspace directory.
sh_binary(
    name = "timed_runs",
    srcs = ["timed_runs.sh"],
)

sh_test(
    name = "timed_runs_test",
    size = "small",
    srcs = ["timed_runs_test.sh"],
    args = ["$(rootpath timed_runs.sh)"],
    data = ["timed_runs.sh"],
)
