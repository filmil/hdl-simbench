load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Correctness first: each simulator must run each case to the cycle count
# RTLMeter expects, with the expected output, before any of its timings
# count. These tests are that check. Timed runs use the same script.

exports_files(["rtlmeter_case.sh"])

# RTLMeter's harness names the main clock as $root.<clock>. Icarus Verilog
# does not support $root, so it gets this copy, made from the unchanged
# third-party file with only "$root." removed. The harness is instantiated
# inside the top module, so "<top>.<clock>" names the same signal there.
genrule(
    name = "harness_noroot",
    srcs = ["//third_party/rtlmeter:harness"],
    outs = ["noroot/__rtlmeter_utils.sv"],
    cmd = "sed -e 's/\\$$root\\.//g' $< > $@ && ! grep -q '\\$$root' $@",
)

_EXAMPLE_ARGS = [
    "--incdir",
    "$(rootpath //third_party/rtlmeter:harness_include)",
    "--top",
    "top",
    "--clock",
    "top.clk",
    "--cycles",
    "1000000",
    "--expect",
    # Quoted inside: Bazel splits test args on spaces, as a shell would.
    "'1000000 - Hello World!'",
]

_EXAMPLE_SRCS = [
    "$(rootpaths //third_party/rtlmeter:harness)",
    "$(rootpaths //third_party/rtlmeter:example_srcs)",
]

sh_test(
    name = "example_verilator_test",
    size = "medium",
    srcs = ["rtlmeter_case.sh"],
    args = [
        "--sim",
        "verilator",
        "--tool",
        "$(rootpath @verilator_prebuilt//:verilator)",
    ] + _EXAMPLE_ARGS + ["--"] + _EXAMPLE_SRCS,
    data = [
        "//third_party/rtlmeter:example_srcs",
        "//third_party/rtlmeter:harness",
        "//third_party/rtlmeter:harness_include",
        "@verilator_prebuilt//:includes",
        "@verilator_prebuilt//:verilator",
    ],
    # Compiles C++ with the host compiler.
    tags = ["requires-cc"],
    # The prebuilt Verilator is a Linux x86-64 binary.
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

sh_test(
    name = "example_iverilog_test",
    size = "medium",
    srcs = ["rtlmeter_case.sh"],
    args = [
        "--sim",
        "iverilog",
        "--tool",
        "$(rootpath @iverilog//:iverilog)",
        "--tool2",
        "$(rootpath @iverilog//:vvp)",
        "--ivl-base",
        "$(rootpath @iverilog//:ivl_base)",
    ] + _EXAMPLE_ARGS + ["--"] + [
        # The harness without $root (see harness_noroot above).
        "$(rootpath :harness_noroot)",
        "$(rootpaths //third_party/rtlmeter:example_srcs)",
    ],
    data = [
        ":harness_noroot",
        "//third_party/rtlmeter:example_srcs",
        "//third_party/rtlmeter:harness_include",
        "@iverilog",
        "@iverilog//:ivl_base",
        "@iverilog//:vvp",
    ],
)

# The check must fail when a case is wrong: here the same Example run under
# Icarus, once with the wrong expected cycle count and once with an expected
# line the design never prints. Each must make rtlmeter_case.sh exit 1.
sh_test(
    name = "check_fails_test",
    size = "medium",
    srcs = ["expect_failure.sh"],
    args = [
        "$(rootpath :rtlmeter_case.sh)",
        "--sim",
        "iverilog",
        "--tool",
        "$(rootpath @iverilog//:iverilog)",
        "--tool2",
        "$(rootpath @iverilog//:vvp)",
        "--ivl-base",
        "$(rootpath @iverilog//:ivl_base)",
        "--incdir",
        "$(rootpath //third_party/rtlmeter:harness_include)",
        "--top",
        "top",
        "--clock",
        "top.clk",
        "--",
        "$(rootpath :harness_noroot)",
        "$(rootpaths //third_party/rtlmeter:example_srcs)",
    ],
    data = [
        ":harness_noroot",
        ":rtlmeter_case.sh",
        "//third_party/rtlmeter:example_srcs",
        "//third_party/rtlmeter:harness_include",
        "@iverilog",
        "@iverilog//:ivl_base",
        "@iverilog//:vvp",
    ],
)
