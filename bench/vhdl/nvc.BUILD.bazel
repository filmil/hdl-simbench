# The NVC release tarball of filmil/bazel_toolchains_nvc: bin/nvc and the
# standard libraries it compiled, lib/nvc (std, ieee, nvc, ...).
package(default_visibility = ["//visibility:public"])

exports_files(["bin/nvc"])

# Every file of the standard libraries; vhdl_case.sh finds their directory
# from lib/nvc/std.08/_NVC_LIB and passes it to NVC with -L.
filegroup(
    name = "std",
    srcs = glob(["lib/nvc/**"]),
)
