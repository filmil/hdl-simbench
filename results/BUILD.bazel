load("@rules_python//python:py_test.bzl", "py_test")

# Every campaign's summary, which the report (//report) is made from: a
# new campaign directory is in the report without further edits.
filegroup(
    name = "summaries",
    srcs = glob(["*/summary.csv"]),
    visibility = ["//report:__pkg__"],
)

# Every published campaign still follows from its per-run files.
py_test(
    name = "results_test",
    size = "small",
    srcs = ["results_test.py"],
    data = glob([
        "*/*.csv",
        "*/*.md",
        "*/commands/*.txt",
    ]),
    deps = ["//tools:summarize_runs_lib"],
)
