load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

exports_files([
    "requirements_lock.txt",
    "rtlmeter_import.py",
])

# Writes third_party/rtlmeter/designs/<design>/cases.bzl from the design's
# descriptor.yaml:
#   bazel run //tools:rtlmeter_import -- third_party/rtlmeter/designs/Servant
py_library(
    name = "rtlmeter_import_lib",
    srcs = ["rtlmeter_import.py"],
    imports = ["."],
    deps = ["@pypi//pyyaml"],
)

py_binary(
    name = "rtlmeter_import",
    srcs = ["rtlmeter_import.py"],
    visibility = ["//visibility:public"],
    deps = ["@pypi//pyyaml"],
)

py_test(
    name = "rtlmeter_import_test",
    size = "small",
    srcs = ["rtlmeter_import_test.py"],
    deps = [":rtlmeter_import_lib"],
)

# Summarizes //bench:timed_runs CSV files by README.md's "Which runs count":
#   bazel run //tools:summarize_runs -- results/slot1.csv
py_library(
    name = "summarize_runs_lib",
    srcs = ["summarize_runs.py"],
    imports = ["."],
    visibility = ["//results:__pkg__"],
)

py_binary(
    name = "summarize_runs",
    srcs = ["summarize_runs.py"],
)

py_test(
    name = "summarize_runs_test",
    size = "small",
    srcs = ["summarize_runs_test.py"],
    deps = [":summarize_runs_lib"],
)

# The report's LaTeX tables, from summarize_runs' CSV output.
py_binary(
    name = "report_tables",
    srcs = ["report_tables.py"],
    visibility = ["//report:__pkg__"],
)

py_test(
    name = "report_tables_test",
    size = "small",
    srcs = ["report_tables_test.py"],
    deps = [":report_tables_lib"],
)

py_library(
    name = "report_tables_lib",
    srcs = ["report_tables.py"],
    imports = ["."],
)
