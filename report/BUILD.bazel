# The report: a PDF built with the hermetic LaTeX toolchain (TinyTeX,
# registered in MODULE.bazel), from each campaign's summary.csv. No number
# is typed into report.tex; see //tools:report_tables.

load("@rules_latex_host//latex:defs.bzl", "latex_document")

# The campaigns, in order: <campaign>=<summary.csv>.
# do not sort: campaigns are listed in the order they ran.
_CAMPAIGNS = [
    ("1", "//results:20261125/summary.csv"),
    ("2", "//results:20261126/summary.csv"),
]

genrule(
    name = "tables",
    srcs = [s for _, s in _CAMPAIGNS],
    outs = [
        "tables.tex",
        "provenance.tex",
    ],
    cmd = "$(execpath //tools:report_tables) --out $(execpath tables.tex) --provenance $(execpath provenance.tex) " +
          " ".join(["%s=$(execpath %s)" % (c, s) for c, s in _CAMPAIGNS]),
    tools = ["//tools:report_tables"],
)

# The release tag, given by the release workflow with
# --define=REPORT_VERSION=<tag>; other builds say "unreleased", so that
# they stay cacheable.
genrule(
    name = "version",
    outs = ["version.tex"],
    cmd = "echo '\\newcommand{\\ReportVersion}{$(REPORT_VERSION)}' > $@",
)

latex_document(
    name = "report",
    main = "report.tex",
    deps = [
        ":provenance.tex",
        ":tables.tex",
        ":version.tex",
    ],
)
