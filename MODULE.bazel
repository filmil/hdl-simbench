"""hdl-simbench: VHDL and SystemVerilog simulators compared on the same designs."""

module(
    name = "hdl_simbench",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# SystemVerilog simulators.

# Verilator, from a prebuilt binary (filmil/bazel_toolchains_verilator), so
# that no build compiles Verilator itself. The bench calls the binary
# directly; it does not use rules_verilator's rules. The binary exists for
# Linux x86-64 only.
bazel_dep(name = "bazel_toolchains_verilator", version = "0.1.0")

verilator_binary = use_extension(
    "@bazel_toolchains_verilator//verilator:extension.bzl",
    "verilator_binary",
)
use_repo(verilator_binary, "verilator_prebuilt")

# xezim, a SystemVerilog simulator in Rust, built from source by its module in
# filmil/bazel-registry (Rust, opt build). Linux x86-64 only.
bazel_dep(name = "xezim", version = "0.11.7")

# Icarus Verilog, built from source by its BCR module.
bazel_dep(name = "iverilog", version = "13.0.bcr.1")

# Python, for //tools:rtlmeter_import, which reads RTLMeter's YAML
# descriptors. PyYAML is pinned to RTLMeter's own version, by hash.
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "pypi")

# VHDL simulators.

# GHDL, built from source by its BCR module, with its mcode back end: GHDL's
# default on x86-64, which compiles the design in memory when it starts.
# The module's other back end, llvm-jit, needs llvm-project built from
# source. GHDL's Ada parts use the GNAT that rules_ada pins: GNAT 15.3.0 from
# periareon/hermetic-gnat 2026.09.30, whose published .sha256
# (36603b28...0aec) matches GitHub's digest of the archive and rules_ada's
# pinned integrity.
bazel_dep(name = "ghdl", version = "6.0.0.bcr.5")

# C, for NEORV32's image_gen tool.
bazel_dep(name = "rules_cc", version = "0.2.19")

# The RISC-V GCC that builds the programs NEORV32 runs (CoreMark). It is the
# xPack build of GCC 15.2.0 with newlib, as NEORV32's own makefiles expect
# (riscv-none-elf-gcc). The sha256 below is the one xPack publishes in
# xpack-riscv-none-elf-gcc-15.2.0-1-linux-x64.tar.gz.sha next to the archive,
# and GitHub's own digest of the archive matches it. Linux x86-64 only.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "riscv_gcc",
    build_file = "//bench/vhdl:riscv_gcc.BUILD.bazel",
    sha256 = "aaaa8060c914851a3e5ee1ba82cc3d6f80972f90638a05c6e823a37557a33758",
    strip_prefix = "xpack-riscv-none-elf-gcc-15.2.0-1",
    urls = ["https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v15.2.0-1/xpack-riscv-none-elf-gcc-15.2.0-1-linux-x64.tar.gz"],
)
