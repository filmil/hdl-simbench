"""hdl-simbench: VHDL and SystemVerilog simulators compared on the same designs."""

module(
    name = "hdl_simbench",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# SystemVerilog simulators.

# Verilator, built from source by its BCR module with the hermetic toolchain
# below: the same compiler as everything else, and no unattested prebuilt
# binary (filmil/bazel_toolchains_verilator#3).
bazel_dep(name = "verilator", version = "5.046.bcr.6")

# xezim, a SystemVerilog simulator in Rust, built from source by its module in
# filmil/bazel-registry (Rust, opt build). Linux x86-64 only.
bazel_dep(name = "xezim", version = "0.11.7.bcr.1")

# Icarus Verilog, built from source by its BCR module.
bazel_dep(name = "iverilog", version = "13.0.bcr.1")

# Python, for //tools:rtlmeter_import, which reads RTLMeter's YAML
# descriptors. PyYAML is pinned to RTLMeter's own version, by hash.
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "pypi")

# A hermetic C/C++ toolchain: LLVM's release build, with a Debian sysroot
# (glibc 2.31), so that every machine compiles with the same compiler and
# libraries. It builds Verilator and Icarus, and it compiles Verilator's model
# and DPI-C sources in the bench (bench/rtlmeter_case.sh). xezim's module
# builds xezim with its own copy of the same LLVM release and sysroot, not
# registered. eph2, where the timed runs happen, has no compiler or C library
# headers of its own.
bazel_dep(name = "toolchains_llvm", version = "1.13.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Chromium's Debian bullseye amd64 sysroot, as listed in Chromium's
# build/linux/sysroot_scripts/sysroots.json (the file name is its SHA-256).
http_archive(
    name = "sysroot_linux_x86_64",
    build_file_content = """
filegroup(
    name = "sysroot",
    # What a compiler and linker read: headers, libraries, startup files.
    srcs = glob(
        [
            "usr/include/**",
            "usr/lib/**",
            "lib/x86_64-linux-gnu/**",
            "lib64/**",
        ],
        exclude = [
            "**/* *",
            "usr/lib/systemd/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

# A file in the sysroot (usr/include/stdio.h), from whose path the runner
# derives the sysroot: three directories up.
exports_files(["usr/include/stdio.h"])
""",
    sha256 = "f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    # The URL has no extension: it is the tarball's SHA-256.
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "23.1.5",
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")
