"""hdl-simbench: VHDL and SystemVerilog simulators compared on the same designs."""

module(
    name = "hdl_simbench",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# SystemVerilog simulators.

# Verilator, built from source by its BCR module with the hermetic toolchain
# below: the same compiler as everything else, and no unattested prebuilt
# binary (filmil/bazel_toolchains_verilator#3).
bazel_dep(name = "verilator", version = "5.046.bcr.6")

# xezim, a SystemVerilog simulator in Rust, built from source by its module in
# filmil/bazel-registry (Rust, opt build). Linux x86-64 only.
bazel_dep(name = "xezim", version = "0.11.7.bcr.2")

# Icarus Verilog, built from source by its BCR module.
bazel_dep(name = "iverilog", version = "13.0.bcr.1")

# Python, for //tools:rtlmeter_import, which reads RTLMeter's YAML
# descriptors. PyYAML is pinned to RTLMeter's own version, by hash.
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "pypi")

# A hermetic C/C++ toolchain: LLVM's release build, with a Debian sysroot
# (glibc 2.31), so that every machine compiles with the same compiler and
# libraries. It builds Verilator and Icarus, and it compiles Verilator's model
# and DPI-C sources in the bench (bench/rtlmeter_case.sh). xezim's module
# builds xezim with its own copy of the same LLVM release and sysroot, not
# registered. eph2, where the timed runs happen, has no compiler or C library
# headers of its own.
bazel_dep(name = "toolchains_llvm", version = "1.13.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Chromium's Debian bullseye amd64 sysroot, as listed in Chromium's
# build/linux/sysroot_scripts/sysroots.json (the file name is its SHA-256).
http_archive(
    name = "sysroot_linux_x86_64",
    build_file_content = """
filegroup(
    name = "sysroot",
    # What a compiler and linker read: headers, libraries, startup files.
    srcs = glob(
        [
            "usr/include/**",
            "usr/lib/**",
            "lib/x86_64-linux-gnu/**",
            "lib64/**",
        ],
        exclude = [
            "**/* *",
            "usr/lib/systemd/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

# A file in the sysroot (usr/include/stdio.h), from whose path the runner
# derives the sysroot: three directories up.
exports_files(["usr/include/stdio.h"])
""",
    sha256 = "f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e",
    # The URL has no extension: it is the tarball's SHA-256.
    type = "tar.xz",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/f851add76bdae472fb6c94b4f920bc4a132d85ac607951391297f636af7e934e"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "23.1.5",
    # The C++ library is LLVM's libc++, with libc++abi, libunwind and
    # compiler-rt, all linked statically (the module's default,
    # "builtin-libc++"), so a built binary needs only glibc from the host.
    # The sysroot has no static libstdc++. Some modules rely on headers that
    # libstdc++ includes by the way; .bazelrc adds those.
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# VHDL simulators.

# GHDL, built from source by its BCR module, with its mcode back end: GHDL's
# default on x86-64, which compiles the design in memory when it starts.
# The module's other back end, llvm-jit, needs llvm-project built from
# source. GHDL's Ada parts use the GNAT that rules_ada 0.3.0 pins by default:
# GNAT 16.1.0 from periareon/hermetic-gnat 2026.09.30, whose published
# .sha256 (f5094291...306d) matches GitHub's digest of the archive and
# rules_ada's pinned integrity.
bazel_dep(name = "ghdl", version = "6.0.0.bcr.5")

# GNAT, which builds GHDL's Ada, linking with the sysroot above
# (//toolchains/gnat). Registered here, so it comes before rules_ada's own
# GNAT toolchain, which links against the build machine's C library.
bazel_dep(name = "rules_ada", version = "0.3.0")

# The same GNAT archive that rules_ada 0.3.0 pins (its versions.bzl), as a
# repository whose files this module can name: periareon/hermetic-gnat
# 2026.09.30; the published .sha256 matches GitHub's digest and this one.
http_archive(
    name = "gnat_linux_x86_64",
    build_file = "//toolchains/gnat:gnat.BUILD.bazel",
    sha256 = "f5094291f3542a360bd41b635a12e4ff1deba86719396073e308860935de306d",
    strip_prefix = "gnat-x86_64-linux-16.1.0",
    urls = ["https://github.com/periareon/hermetic-gnat/releases/download/2026.09.30/gnat-x86_64-linux-16.1.0.tar.gz"],
)

register_toolchains("//toolchains/gnat:gnat_linux_x86_64")

# The patch (see its header) adds upstream's release flags, -O -gnatn, to
# GHDL's Ada, which the module compiles at -O0, and links GNAT's libstdc++
# into ghdl, so that it needs only glibc from the host.
single_version_override(
    module_name = "ghdl",
    # The patch is written against this version.
    version = "6.0.0.bcr.5",
    patch_strip = 1,
    patches = ["//bench/vhdl:ghdl.patch"],
)

# C, for NEORV32's image_gen tool.
bazel_dep(name = "rules_cc", version = "0.2.28")

# The RISC-V GCC that builds the programs NEORV32 runs (CoreMark). It is the
# xPack build of GCC 15.2.0 with newlib, as NEORV32's own makefiles expect
# (riscv-none-elf-gcc). The sha256 below is the one xPack publishes in
# xpack-riscv-none-elf-gcc-15.2.0-1-linux-x64.tar.gz.sha next to the archive,
# and GitHub's own digest of the archive matches it. Linux x86-64 only.
http_archive(
    name = "riscv_gcc",
    build_file = "//bench/vhdl:riscv_gcc.BUILD.bazel",
    sha256 = "aaaa8060c914851a3e5ee1ba82cc3d6f80972f90638a05c6e823a37557a33758",
    strip_prefix = "xpack-riscv-none-elf-gcc-15.2.0-1",
    urls = ["https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v15.2.0-1/xpack-riscv-none-elf-gcc-15.2.0-1-linux-x64.tar.gz"],
)
